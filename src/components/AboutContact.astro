---
import { site } from "../data/site";

// Each group only lists tools my repositories or coursework actually use.
// Each row only lists tools my repositories, coursework or work actually use.
const skills = [
  { group: "data", items: ["Python", "SQL", "R", "pandas", "NumPy", "PostgreSQL", "Supabase", "SciPy", "BigQuery", "Snowflake", "dbt", "Power BI", "Tableau"] },
  { group: "ML / AI", items: ["scikit-learn", "XGBoost", "statsmodels", "mixed-effects models", "RAG", "pgvector", "LLM APIs", "MLflow", "model evaluation"] },
  { group: "engineering", items: ["FastAPI", "React", "TypeScript", "Docker", "PySpark", "Streamlit", "pytest", "Git", "GitHub Actions"] },
];

const hobbies = [
  { label: "hiking", d: "M4 40 L18 15 L26 27 L32 19 L44 40 Z M14 22 l4 3 l3 -4" },
  { label: "gym", d: "M11 15 v18 M6 19 v10 M37 15 v18 M42 19 v10 M11 24 h26" },
  { label: "running", d: "M5 35 q0 -7 7 -8 l8 -2 l5 -9 q5 1 6 6 l9 3 q7 2 7 9 v2 H5 Z M5 37 h39 M22 22 l3 2 M24 19 l3 2" },
  { label: "photos", d: "M5 15 h9 l3 -5 h14 l3 5 h9 v24 H5 Z M24 19 a8 8 0 1 0 0.01 0 M37 20 h2" },
  { label: "music", d: "M8 30 v-6 a16 16 0 0 1 32 0 v6 M5 29 h7 v11 h-7 Z M36 29 h7 v11 h-7 Z" },
];

const socials = [
  { label: "GitHub", href: site.github },
  { label: "LinkedIn", href: site.linkedin },
  { label: "Instagram", href: site.instagram },
].filter((s) => s.href);
---

<section class="row about" id="about" aria-labelledby="about-title">
  <h2 class="marker label" id="about-title" data-write>about me</h2>
  <p class="big" data-reveal>
    When I'm not at my laptop, I'm usually out on a <em>hike</em>, at the <em>gym</em>, on a <em>run</em>, or taking <em>photos</em>.
    There's always music playing.
  </p>
  <ul class="hobbies" data-reveal-group>
    {
      hobbies.map((h) => (
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path filter="url(#wobble)" d={h.d} />
          </svg>
          <span class="marker">{h.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="row kit" aria-labelledby="kit-title">
  <h2 class="marker label" id="kit-title" data-write>what I reach for</h2>
  <!-- the full list for screen readers; the moving rows below are decoration -->
  <ul class="sr-only">
    {skills.map((s) => <li>{s.group}: {s.items.join(", ")}</li>)}
  </ul>
  <div class="ticker" aria-hidden="true" data-reveal-group>
    {
      skills.map((s, i) => (
        <div class={`tick-row${i % 2 ? " rev" : ""}`} style={`--dur:${42 + i * 6}s`}>
          <span class="tick-label marker">{s.group}</span>
          <div class="tick-track">
            {[0, 1].map(() => (
              <div class="tick-set">
                {s.items.map((it, k) => (
                  <>
                    <span class={k % 2 ? "it" : undefined}>{it}</span>
                    <svg viewBox="0 0 20 20" class="star">
                      <path filter="url(#wobble)" d="M10 2 L11.8 8.2 L18 10 L11.8 11.8 L10 18 L8.2 11.8 L2 10 L8.2 8.2 Z" />
                    </svg>
                  </>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="row contact" id="contact" aria-labelledby="contact-title">
  <h2 class="sr-only" id="contact-title">Let's talk.</h2>
  <p class="place" data-reveal><span><span class="dot" aria-hidden="true"></span>Washington, DC</span></p>
  <a class="email" data-reveal href={`mailto:${site.email}`}>{site.email}</a>
  <ul class="links" data-reveal-group>
    {
      socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">
            {s.label}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .row {
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 9vh, 6rem) var(--gutter);
  }
  .row + .row {
    border-top: 1px dashed #c9c4b7;
  }
  h2 {
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }
  .label {
    font-size: clamp(2rem, 3.6vw, 3rem);
  }

  /* About */
  .about {
    padding-top: clamp(5rem, 12vh, 8rem);
  }
  .big {
    max-width: 24em;
    margin: 1.4rem 0 0;
    font: 400 clamp(1.8rem, 3.4vw, 3.1rem) / 1.12 var(--serif);
    letter-spacing: -0.005em;
  }
  .hobbies {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 1.8rem;
    margin: 2.2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hobbies li {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }
  .hobbies svg {
    width: 3.2rem;
    height: 3.2rem;
    overflow: visible;
  }
  .hobbies path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hobbies span {
    font-size: 1rem;
  }

  /* Skills: three slow rows of type that drift in opposite directions and pause under the cursor */
  .ticker {
    display: grid;
    gap: 0.4rem;
    margin: 2rem calc(var(--gutter) * -1) 0;
  }
  .tick-row {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.7rem 0;
    border-top: 1px solid #d3cec2;
    overflow: hidden;
  }
  .tick-row:last-child {
    border-bottom: 1px solid #d3cec2;
  }
  /* the label holds still on a solid strip; the words slide out from under a soft fade */
  .tick-label {
    position: relative;
    z-index: 2;
    flex: none;
    align-self: stretch;
    display: flex;
    align-items: center;
    width: clamp(7.5rem, 13vw, 11rem);
    padding-left: var(--gutter);
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1;
    background: var(--paper);
  }
  .tick-label::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 3rem;
    background: linear-gradient(to right, var(--paper), transparent);
  }
  .tick-track {
    display: flex;
    width: max-content;
    animation: tick var(--dur) linear infinite;
  }
  .rev .tick-track {
    animation-direction: reverse;
  }
  .tick-row:hover .tick-track {
    animation-play-state: paused;
  }
  .tick-set {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.8rem);
    padding-right: clamp(1rem, 2vw, 1.8rem);
    font: 400 clamp(1.9rem, 4.2vw, 3.6rem) / 1.1 var(--serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .tick-set .it {
    font-style: italic;
    color: var(--ink-2);
  }
  .star {
    width: 0.42em;
    height: 0.42em;
    flex: none;
  }
  .star path {
    fill: var(--ink);
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tick-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
    }
    .tick-set + .tick-set {
      display: none;
    }
    .tick-set {
      flex-wrap: wrap;
      white-space: normal;
      padding: 0 var(--gutter) 0 0;
    }
  }

  /* Contact: a quiet line with where I am, the email large, links in spaced capitals */
  .contact {
    display: grid;
    justify-items: center;
    gap: clamp(1.4rem, 3vw, 2rem);
    text-align: center;
    padding-block: clamp(5rem, 14vh, 8rem);
  }
  .place {
    justify-self: stretch;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    color: var(--ink-2);
    font: 500 0.78rem/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .place::before,
  .place::after {
    content: "";
    height: 1px;
    background: #cfc9bc;
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.6rem;
    vertical-align: 1px;
    border-radius: 50%;
    background: #3f8f5a;
    box-shadow: 0 0 0 3px rgb(63 143 90 / 0.18);
  }
  .email {
    position: relative;
    font: italic 500 clamp(2.1rem, 6.4vw, 5.2rem) / 1.1 "Cormorant Garamond", "Instrument Serif Fallback", Georgia, serif;
    letter-spacing: -0.005em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .email::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08em;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .email:hover::after,
  .email:focus-visible::after {
    transform: scaleX(1);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1.4rem, 4vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: 0.7rem 0 0.35rem;
    border-bottom: 1px solid transparent;
    font: 500 0.8rem/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .links a:hover,
  .links a:focus-visible {
    border-color: var(--ink);
  }

  @media (max-width: 480px) {
    .hobbies {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .hobbies svg {
      width: 2.6rem;
      height: 2.6rem;
    }
    .hobbies span {
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .email::after {
      transition: none;
    }
  }
</style>
