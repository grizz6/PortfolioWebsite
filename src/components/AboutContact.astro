---
import { site } from "../data/site";

// Each group only lists tools my repositories or coursework actually use.
// Each row only lists tools my repositories, coursework or work actually use.
const skills = [
  { group: "data", items: ["Python", "SQL", "R", "pandas", "NumPy", "PostgreSQL", "BigQuery", "Snowflake", "dbt", "Airflow", "Power BI", "Tableau"] },
  { group: "ML / AI", items: ["scikit-learn", "XGBoost", "statsmodels", "mixed-effects models", "RAG", "pgvector", "LLM APIs", "MLflow", "model evaluation"] },
  { group: "engineering", items: ["FastAPI", "React", "TypeScript", "Docker", "PySpark", "Streamlit", "pytest", "GitHub Actions"] },
];

const hobbies = [
  { label: "hiking", d: "M4 40 L18 15 L26 27 L32 19 L44 40 Z M14 22 l4 3 l3 -4" },
  { label: "gym", d: "M11 15 v18 M6 19 v10 M37 15 v18 M42 19 v10 M11 24 h26" },
  { label: "running", d: "M5 35 q0 -7 7 -8 l8 -2 l5 -9 q5 1 6 6 l9 3 q7 2 7 9 v2 H5 Z M5 37 h39 M22 22 l3 2 M24 19 l3 2" },
  { label: "photos", d: "M5 15 h9 l3 -5 h14 l3 5 h9 v24 H5 Z M24 19 a8 8 0 1 0 0.01 0 M37 20 h2" },
  { label: "music", d: "M8 30 v-6 a16 16 0 0 1 32 0 v6 M5 29 h7 v11 h-7 Z M36 29 h7 v11 h-7 Z" },
];

const icons = {
  github:
    '<path d="M7 15.5c-3 1-3-1.5-4.5-2m9 4v-2.6a2.3 2.3 0 0 0-.6-1.7c2.1-.3 4.3-1 4.3-4.6a3.6 3.6 0 0 0-1-2.5 3.3 3.3 0 0 0-.1-2.5s-.8-.3-2.6 1a9 9 0 0 0-4.7 0C5 3.4 4.2 3.7 4.2 3.7a3.3 3.3 0 0 0 0 2.5 3.6 3.6 0 0 0-1 2.5c0 3.6 2.2 4.3 4.3 4.6a2.3 2.3 0 0 0-.6 1.7v2.6"/>',
  linkedin: '<rect x="2.5" y="2.5" width="15" height="15" rx="2.5"/><path d="M6.5 9v4.5M6.5 6.5v.01M9.5 13.5V9m0 2.2c0-1.3 1-2.2 2.1-2.2s1.9.8 1.9 2.2v2.3"/>',
  instagram: '<rect x="2.5" y="2.5" width="15" height="15" rx="4.5"/><circle cx="10" cy="10" r="3.3"/><path d="M14.4 5.6v.01"/>',
};
const socials = [
  { label: "GitHub", href: site.github, icon: icons.github },
  { label: "LinkedIn", href: site.linkedin, icon: icons.linkedin },
  { label: "Instagram", href: site.instagram, icon: icons.instagram },
].filter((s) => s.href);
---

<section class="row about" id="about" aria-labelledby="about-title">
  <h2 class="marker label" id="about-title" data-reveal>about me</h2>
  <p class="big" data-reveal>
    When I'm not at my laptop, I'm usually out on a <em>hike</em>, at the <em>gym</em>, on a <em>run</em>, or taking <em>photos</em>.
    There's always music playing.
  </p>
  <ul class="hobbies" data-reveal-group>
    {
      hobbies.map((h) => (
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path filter="url(#wobble)" d={h.d} />
          </svg>
          <span class="marker">{h.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="row kit" aria-labelledby="kit-title">
  <h2 class="marker label" id="kit-title" data-reveal>what I reach for</h2>
  <!-- the full list for screen readers; the moving rows below are decoration -->
  <ul class="sr-only">
    {skills.map((s) => <li>{s.group}: {s.items.join(", ")}</li>)}
  </ul>
  <div class="ticker" aria-hidden="true" data-reveal-group>
    {
      skills.map((s, i) => (
        <div class={`tick-row${i % 2 ? " rev" : ""}`} style={`--dur:${42 + i * 6}s`}>
          <span class="tick-label marker">{s.group}</span>
          <div class="tick-track">
            {[0, 1].map(() => (
              <div class="tick-set">
                {s.items.map((it, k) => (
                  <>
                    <span class={k % 2 ? "it" : undefined}>{it}</span>
                    <svg viewBox="0 0 20 20" class="star">
                      <path filter="url(#wobble)" d="M10 2 L11.8 8.2 L18 10 L11.8 11.8 L10 18 L8.2 11.8 L2 10 L8.2 8.2 Z" />
                    </svg>
                  </>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="row contact" id="contact" aria-labelledby="contact-title">
  <h2 class="marker talk" id="contact-title" data-reveal>let's talk.</h2>
  <a class="email" data-reveal href={`mailto:${site.email}`}>{site.email}</a>
  <ul class="links" data-reveal-group>
    {
      socials.map((s) => (
        <li>
          <a class="pill" href={s.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            {s.label}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .row {
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 9vh, 6rem) var(--gutter);
  }
  .row + .row {
    border-top: 1px dashed #c9c4b7;
  }
  h2 {
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }
  .label {
    font-size: clamp(2rem, 3.6vw, 3rem);
  }

  /* About */
  .about {
    padding-top: clamp(5rem, 12vh, 8rem);
  }
  .big {
    max-width: 24em;
    margin: 1.4rem 0 0;
    font: 400 clamp(1.8rem, 3.4vw, 3.1rem) / 1.12 var(--serif);
    letter-spacing: -0.005em;
  }
  .hobbies {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 1.8rem;
    margin: 2.2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hobbies li {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }
  .hobbies svg {
    width: 3.2rem;
    height: 3.2rem;
    overflow: visible;
  }
  .hobbies path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hobbies span {
    font-size: 1rem;
  }

  /* Skills: three slow rows of type that drift in opposite directions and pause under the cursor */
  .ticker {
    display: grid;
    gap: 0.4rem;
    margin: 2rem calc(var(--gutter) * -1) 0;
  }
  .tick-row {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.7rem 0;
    border-top: 1px solid #d3cec2;
    overflow: hidden;
  }
  .tick-row:last-child {
    border-bottom: 1px solid #d3cec2;
  }
  /* the label holds still on a solid strip; the words slide out from under a soft fade */
  .tick-label {
    position: relative;
    z-index: 2;
    flex: none;
    align-self: stretch;
    display: flex;
    align-items: center;
    width: clamp(7.5rem, 13vw, 11rem);
    padding-left: var(--gutter);
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1;
    background: var(--paper);
  }
  .tick-label::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 3rem;
    background: linear-gradient(to right, var(--paper), transparent);
  }
  .tick-track {
    display: flex;
    width: max-content;
    animation: tick var(--dur) linear infinite;
  }
  .rev .tick-track {
    animation-direction: reverse;
  }
  .tick-row:hover .tick-track {
    animation-play-state: paused;
  }
  .tick-set {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.8rem);
    padding-right: clamp(1rem, 2vw, 1.8rem);
    font: 400 clamp(1.9rem, 4.2vw, 3.6rem) / 1.1 var(--serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .tick-set .it {
    font-style: italic;
    color: var(--ink-2);
  }
  .star {
    width: 0.42em;
    height: 0.42em;
    flex: none;
  }
  .star path {
    fill: var(--ink);
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tick-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
    }
    .tick-set + .tick-set {
      display: none;
    }
    .tick-set {
      flex-wrap: wrap;
      white-space: normal;
      padding: 0 var(--gutter) 0 0;
    }
  }

  /* Contact */
  .contact {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
    padding-bottom: clamp(4rem, 10vh, 6rem);
  }
  .talk {
    font-size: clamp(3.6rem, 11vw, 10rem);
    line-height: 0.95;
  }
  .email {
    font: italic 400 clamp(1.6rem, 3.4vw, 2.8rem) / 1.2 var(--serif);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--ink), var(--ink)) left bottom / 0% 2px no-repeat;
    padding-bottom: 0.1em;
    transition: background-size 0.45s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .email:hover,
  .email:focus-visible {
    background-size: 100% 2px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {

  }
  @media (max-width: 480px) {
    .hobbies {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .hobbies svg {
      width: 2.6rem;
      height: 2.6rem;
    }
    .hobbies span {
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .email {
      transition: none;
    }
  }
</style>
