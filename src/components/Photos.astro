---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import captionsJson from "../assets/photos/photos.json";

// Every image in src/assets/photos shows up here, in file-name order.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", {
  eager: true,
});
const texts = import.meta.glob<string>("../assets/photos/*.txt", { eager: true, query: "?raw", import: "default" });
const json = captionsJson as Record<string, { alt?: string; caption?: string }>;

const base = (p: string) => p.split("/").pop()!;
const stem = (p: string) => base(p).replace(/\.[^.]+$/, "");

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod], i) => {
      const img = mod.default;
      const txt = Object.entries(texts).find(([t]) => stem(t) === stem(path))?.[1];
      const [txtCaption, txtAlt] = (txt ?? "").split(/\r?\n/).map((s) => s.trim());
      const meta = json[base(path)] ?? {};
      const caption = txtCaption || meta.caption || "";
      const alt = txtAlt || meta.alt || caption || stem(path).replace(/[-_]+/g, " ");
      const full = await getImage({ src: img, width: Math.min(img.width, 2000), format: "webp" });
      const widths = [...new Set([240, 360, 480, 720, 1000].filter((w) => w < img.width).concat(img.width))];
      return { img, alt, caption, full: full.src, widths, ratio: img.width / img.height };
    }),
);

---

<section class="photos" id="photos" aria-labelledby="photos-title" data-photos>
  <div class="pin" data-pin>
    <div class="head">
      <h2 id="photos-title" class="marker">through my lens</h2>
      <p class="meta" aria-hidden="true"><span data-now>01</span> / {String(photos.length).padStart(2, "0")}</p>
    </div>

    <!-- one long strip that slides sideways as you scroll down -->
    <ol class="strip" data-strip>
      {
        photos.map((p, i) => (
          <li class="shot" style={`--r:${p.ratio.toFixed(3)}`} data-shot>
            <button type="button" class="frame" data-photo={i} data-full={p.full} data-alt={p.alt} data-caption={p.caption}>
              <span class="inner" data-inner>
                <Picture
                  src={p.img}
                  alt={p.alt}
                  formats={["avif", "webp"]}
                  widths={p.widths}
                  sizes="(max-width: 640px) 80vw, 40vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </button>
            <p class="cap">
              <span class="no">{String(i + 1).padStart(2, "0")}</span>
              {p.caption && <span>{p.caption}</span>}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="bar" aria-hidden="true"><span data-bar></span></div>
  </div>

  <dialog class="viewer" aria-labelledby="viewer-title" data-viewer data-lenis-prevent>
    <h2 class="sr-only" id="viewer-title">Photo viewer</h2>
    <figure>
      <span class="vimg" data-viewer-img></span>
      <figcaption>
        <span data-viewer-cap></span>
        <span class="count" data-viewer-count></span>
      </figcaption>
    </figure>
    <button type="button" class="vbtn close" data-close aria-label="Close">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
    </button>
    <button type="button" class="vbtn prev" data-prev aria-label="Previous photo">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4l-6 6 6 6" /></svg>
    </button>
    <button type="button" class="vbtn next" data-next aria-label="Next photo">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4l6 6-6 6" /></svg>
    </button>
  </dialog>
</section>

<style>
  .photos {
    position: relative;
  }
  .pin {
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: 100%;
    gap: clamp(1rem, 3vh, 2rem);
    height: 100vh;
    height: 100svh;
    padding: clamp(5rem, 11vh, 7rem) 0 clamp(1.5rem, 4vh, 2.5rem);
    overflow: hidden;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter);
  }
  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1;
  }
  .meta {
    margin: 0;
    color: var(--ink-2);
    font: 500 clamp(0.9rem, 1.2vw, 1.05rem) var(--sans);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  /* the strip: every photo the same height, as wide as its shape needs */
  .strip {
    --h: min(58vh, 34rem);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    justify-self: start;
    width: max-content;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    will-change: transform;
  }
  .shot {
    flex: none;
    width: calc(var(--h) * var(--r));
  }
  /* a gentle up and down rhythm along the strip */
  .shot:nth-child(3n + 2) {
    margin-top: 5vh;
  }
  .shot:nth-child(3n) {
    margin-top: -4vh;
  }
  .frame {
    display: block;
    width: 100%;
    height: var(--h);
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #dcd8ce;
    cursor: zoom-in;
  }
  .inner {
    display: block;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .inner :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .inner :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the photo is a little larger than its frame, so it can drift inside without showing an edge */
    transform: translateX(var(--px, 0%)) scale(var(--zoom, 1.14));
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame:hover,
  .frame:focus-visible {
    --zoom: 1.1;
  }
  .cap {
    display: flex;
    gap: 0.7rem;
    margin: 0.7rem 0 0;
    color: var(--ink-2);
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .no {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    margin-inline: var(--gutter);
    height: 2px;
    background: #d3cec2;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* without motion, or before the script runs, the strip is a plain sideways scroller */
  .photos:not(.driven) .pin {
    height: auto;
  }
  .photos:not(.driven) .strip {
    width: auto;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
  }
  .photos:not(.driven) .shot {
    scroll-snap-align: start;
  }
  .photos:not(.driven) .bar {
    display: none;
  }

  /* Viewer */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(22 21 15 / 0.92);
    color: var(--paper);
  }
  .viewer[open] {
    display: grid;
    place-items: center;
  }
  .viewer::backdrop {
    background: transparent;
  }
  figure {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    margin: 0;
  }
  figure img {
    max-width: min(92vw, 70rem);
    max-height: 80dvh;
    width: auto;
    height: auto;
    border: 0.5rem solid #fff;
  }
  .count {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    font: italic 400 1.25rem/1.3 var(--serif);
    text-align: center;
  }
  .vbtn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--pill);
    color: var(--ink);
    cursor: pointer;
  }
  .vbtn:hover {
    background: var(--paper);
  }
  .vbtn:focus-visible {
    outline-color: var(--paper);
  }
  .vbtn svg {
    width: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .prev,
  .next {
    top: 50%;
    translate: 0 -50%;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    .strip {
      --h: min(52vh, 26rem);
    }
    .shot:nth-child(n) {
      margin-top: 0;
    }
    .prev,
    .next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .inner :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-photos]");
  const strip = document.querySelector<HTMLElement>("[data-strip]");
  const viewer = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && strip && viewer) {
    const allPrints = [...strip.querySelectorAll<HTMLButtonElement>("[data-photo]")];
    const inners = [...strip.querySelectorAll<HTMLElement>("[data-inner]")];
    const now = section.querySelector<HTMLElement>("[data-now]")!;
    const bar = section.querySelector<HTMLElement>("[data-bar]")!;

    if (!reduce) {
      section.classList.add("driven");
      // The section pins and your scroll slides the strip sideways. Each photo also drifts a little inside
      // its frame, and the strip leans slightly with your scroll speed, then settles.
      const distance = () => strip.scrollWidth - innerWidth;
      const lean = gsap.quickTo(strip, "skewX", { duration: 0.5, ease: "power3.out" });
      gsap.to(strip, {
        x: () => -distance(),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          pin: section.querySelector("[data-pin]"),
          start: "top top",
          end: () => "+=" + distance(),
          scrub: 0.8,
          invalidateOnRefresh: true,
          onUpdate(self) {
            const p = self.progress;
            bar.style.transform = `scaleX(${p.toFixed(4)})`;
            now.textContent = String(Math.min(allPrints.length, Math.floor(p * (allPrints.length - 1)) + 1)).padStart(2, "0");
            lean(gsap.utils.clamp(-4, 4, self.getVelocity() / -400));
            inners.forEach((el) => {
              const r = el.getBoundingClientRect();
              // -1 at the left edge, 0 in the middle, 1 at the right edge; photos further out stay at the limit
              const off = gsap.utils.clamp(-1, 1, (r.left + r.width / 2 - innerWidth / 2) / (innerWidth / 2));
              el.style.setProperty("--px", `${(off * -5).toFixed(2)}%`);
            });
          },
        },
      });
      ScrollTrigger.addEventListener("scrollEnd", () => lean(0));
    }

    // the viewer
    // the viewer's image is made on first open, so the page never ships an image without a source
    const img = document.createElement("img");
    const slot = viewer.querySelector("[data-viewer-img]")!;
    const cap = viewer.querySelector<HTMLElement>("[data-viewer-cap]")!;
    const count = viewer.querySelector<HTMLElement>("[data-viewer-count]")!;
    let at = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      at = (i + allPrints.length) % allPrints.length;
      const p = allPrints[at];
      if (!img.isConnected) slot.replaceWith(img);
      img.src = p.dataset.full!;
      img.alt = p.dataset.alt!;
      cap.textContent = p.dataset.caption ?? "";
      cap.hidden = !p.dataset.caption;
      count.textContent = `${at + 1} / ${allPrints.length}`;
    };
    allPrints.forEach((p, i) =>
      p.addEventListener("click", () => {
        opener = p;
        show(i);
        viewer.showModal();
      }),
    );
    viewer.querySelector("[data-close]")!.addEventListener("click", () => viewer.close());
    viewer.querySelector("[data-prev]")!.addEventListener("click", () => show(at - 1));
    viewer.querySelector("[data-next]")!.addEventListener("click", () => show(at + 1));
    viewer.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(at - 1);
      if (e.key === "ArrowRight") show(at + 1);
    });
    // a click on the dark surround closes it
    viewer.addEventListener("click", (e) => {
      if (e.target === viewer) viewer.close();
    });
    viewer.addEventListener("close", () => opener?.focus());
  }
</script>
