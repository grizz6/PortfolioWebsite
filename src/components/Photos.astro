---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import captionsJson from "../assets/photos/photos.json";

// Every image in src/assets/photos shows up here, in file-name order.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", {
  eager: true,
});
const texts = import.meta.glob<string>("../assets/photos/*.txt", { eager: true, query: "?raw", import: "default" });
const json = captionsJson as Record<string, { alt?: string; caption?: string }>;

const base = (p: string) => p.split("/").pop()!;
const stem = (p: string) => base(p).replace(/\.[^.]+$/, "");

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod], i) => {
      const img = mod.default;
      const txt = Object.entries(texts).find(([t]) => stem(t) === stem(path))?.[1];
      const [txtCaption, txtAlt] = (txt ?? "").split(/\r?\n/).map((s) => s.trim());
      const meta = json[base(path)] ?? {};
      const caption = txtCaption || meta.caption || "";
      const alt = txtAlt || meta.alt || caption || stem(path).replace(/[-_]+/g, " ");
      const full = await getImage({ src: img, width: Math.min(img.width, 2000), format: "webp" });
      const widths = [...new Set([240, 360, 480, 720, 1000].filter((w) => w < img.width).concat(img.width))];
      return { img, alt, caption, full: full.src, widths, tilt: [-2.4, 1.8, -1.2, 2.6, -1.8, 1.1][i % 6] };
    }),
);

// four columns (two on phones), filled in turn
const columns = [0, 1, 2, 3].map((c) => photos.map((p, i) => ({ ...p, i })).filter((p) => p.i % 4 === c));
---

<section class="photos" id="photos" aria-labelledby="photos-title">
  <div class="head">
    <h2 id="photos-title" class="marker">through my lens</h2>
  </div>

  <div class="grid" data-grid>
    {
      columns.map((col, c) => (
        <ul class="col" data-col={c}>
          {col.map((p) => (
            <li>
              <button
                type="button"
                class="print"
                style={`--tilt:${p.tilt}deg`}
                data-photo={p.i}
                data-full={p.full}
                data-alt={p.alt}
                data-caption={p.caption}
              >
                <Picture
                  src={p.img}
                  alt={p.alt}
                  formats={["avif", "webp"]}
                  widths={p.widths}
                  sizes="(max-width: 640px) 46vw, 23vw"
                  loading="lazy"
                  decoding="async"
                />
                {p.caption && <span class="cap">{p.caption}</span>}
              </button>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <dialog class="viewer" aria-labelledby="viewer-title" data-viewer>
    <h2 class="sr-only" id="viewer-title">Photo viewer</h2>
    <figure>
      <span class="vimg" data-viewer-img></span>
      <figcaption data-viewer-cap></figcaption>
    </figure>
    <button type="button" class="vbtn close" data-close aria-label="Close">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
    </button>
    <button type="button" class="vbtn prev" data-prev aria-label="Previous photo">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4l-6 6 6 6" /></svg>
    </button>
    <button type="button" class="vbtn next" data-next aria-label="Next photo">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4l6 6-6 6" /></svg>
    </button>
  </dialog>
</section>

<style>
  .photos {
    padding: clamp(4rem, 10vh, 7rem) var(--gutter) clamp(5rem, 14vh, 9rem);
    overflow: clip;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.6rem;
    max-width: 82rem;
    margin: 0 auto clamp(2.5rem, 6vh, 4rem);
  }
  h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5.4vw, 4.8rem);
    line-height: 1;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 2.2rem);
    max-width: 82rem;
    margin: 0 auto;
  }
  .col {
    display: grid;
    align-content: start;
    gap: clamp(1.2rem, 2.6vw, 2.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* staggered starts */
  .col:nth-child(2) {
    padding-top: 4rem;
  }
  .col:nth-child(3) {
    padding-top: 1.5rem;
  }
  .col:nth-child(4) {
    padding-top: 6rem;
  }
  .print {
    display: block;
    width: 100%;
    padding: 0.55rem 0.55rem 0.7rem;
    border: 0;
    background: #fff;
    color: inherit;
    text-align: left;
    cursor: zoom-in;
    box-shadow:
      0 2px 3px rgb(22 21 15 / 0.08),
      0 16px 28px -12px rgb(22 21 15 / 0.24);
    transform: rotate(var(--tilt));
    transition:
      transform 0.35s cubic-bezier(0.3, 0.7, 0.4, 1),
      box-shadow 0.35s;
  }
  .print:hover,
  .print:focus-visible {
    transform: rotate(0deg) scale(1.04);
    box-shadow:
      0 4px 6px rgb(22 21 15 / 0.1),
      0 26px 40px -14px rgb(22 21 15 / 0.3);
  }
  .print :global(img) {
    width: 100%;
    height: auto;
  }
  .cap {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  /* Viewer */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(22 21 15 / 0.92);
    color: var(--paper);
  }
  .viewer[open] {
    display: grid;
    place-items: center;
  }
  .viewer::backdrop {
    background: transparent;
  }
  figure {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    margin: 0;
  }
  figure img {
    max-width: min(92vw, 70rem);
    max-height: 80dvh;
    width: auto;
    height: auto;
    border: 0.5rem solid #fff;
  }
  figcaption {
    font: italic 400 1.25rem/1.3 var(--serif);
    text-align: center;
  }
  .vbtn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--pill);
    color: var(--ink);
    cursor: pointer;
  }
  .vbtn:hover {
    background: var(--paper);
  }
  .vbtn:focus-visible {
    outline-color: var(--paper);
  }
  .vbtn svg {
    width: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .prev,
  .next {
    top: 50%;
    translate: 0 -50%;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* the script folds four columns into two; any left empty take no room */
    .col:empty {
      display: none;
    }
    .col:nth-child(2) {
      padding-top: 3rem;
    }
    .cap {
      font-size: 0.72rem;
    }
    .prev,
    .next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .print {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const grid = document.querySelector<HTMLElement>("[data-grid]");
  const viewer = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const phone = matchMedia("(max-width: 640px)");

  if (grid && viewer) {
    const allPrints = [...grid.querySelectorAll<HTMLButtonElement>("[data-photo]")].sort(
      (a, b) => Number(a.dataset.photo) - Number(b.dataset.photo),
    );

    // On phones, columns 3 and 4 hide and their prints move into columns 1 and 2
    const cols = [...grid.querySelectorAll<HTMLElement>("[data-col]")];
    const lay = () => {
      const n = phone.matches ? 2 : 4;
      allPrints.forEach((p, i) => cols[i % n].appendChild(p.parentElement!));
    };
    lay();
    phone.addEventListener("change", () => {
      lay();
      ScrollTrigger.refresh();
    });

    // columns drift at different speeds while scrolling
    if (!reduce) {
      const drift = [-60, 50, -110, 30];
      cols.forEach((col, c) =>
        gsap.fromTo(
          col,
          { y: -drift[c] / 2 },
          {
            y: drift[c] / 2,
            ease: "none",
            scrollTrigger: { trigger: grid, start: "top bottom", end: "bottom top", scrub: 0.5 },
          },
        ),
      );
    }

    // the viewer
    // the viewer's image is made on first open, so the page never ships an image without a source
    const img = document.createElement("img");
    const slot = viewer.querySelector("[data-viewer-img]")!;
    const cap = viewer.querySelector<HTMLElement>("[data-viewer-cap]")!;
    let at = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      at = (i + allPrints.length) % allPrints.length;
      const p = allPrints[at];
      if (!img.isConnected) slot.replaceWith(img);
      img.src = p.dataset.full!;
      img.alt = p.dataset.alt!;
      cap.textContent = p.dataset.caption ?? "";
      cap.hidden = !p.dataset.caption;
    };
    allPrints.forEach((p, i) =>
      p.addEventListener("click", () => {
        opener = p;
        show(i);
        viewer.showModal();
      }),
    );
    viewer.querySelector("[data-close]")!.addEventListener("click", () => viewer.close());
    viewer.querySelector("[data-prev]")!.addEventListener("click", () => show(at - 1));
    viewer.querySelector("[data-next]")!.addEventListener("click", () => show(at + 1));
    viewer.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(at - 1);
      if (e.key === "ArrowRight") show(at + 1);
    });
    // a click on the dark surround closes it
    viewer.addEventListener("click", (e) => {
      if (e.target === viewer) viewer.close();
    });
    viewer.addEventListener("close", () => opener?.focus());
  }
</script>
