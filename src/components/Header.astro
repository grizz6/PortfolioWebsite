---
const links = [
  {
    href: "#work",
    label: "Work",
    icon: '<rect x="2.5" y="3.5" width="15" height="13" rx="2"/><path d="M2.5 7.5h15M5.5 5.5h.01M7.5 5.5h.01"/>',
  },
  {
    href: "#photos",
    label: "Photos",
    icon: '<path d="M3 6.5h3l1.5-2h5L14 6.5h3v9.5H3z"/><circle cx="10" cy="11" r="3"/>',
  },
  {
    href: "#about",
    label: "About",
    icon: '<path d="M4 16l1-4 8.5-8.5a2.1 2.1 0 013 3L8 15z"/><path d="M12 5l3 3"/>',
  },
];
const mail = '<rect x="2.5" y="4.5" width="15" height="11" rx="1.5"/><path d="M3 5.5l7 5.5 7-5.5"/>';
---

<header class="site-header" data-header>
  <a class="logo marker" href="#top">grishma<span class="sr-only">, back to the top</span></a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a class="pill" href={l.href}>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
              <span class="label">{l.label}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="pill pill--dark" href="#contact">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mail} />
          <span>Contact</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
    pointer-events: none;
    transition: background-color 0.3s, box-shadow 0.3s;
  }
  /* transparent over the desk; once the page moves on, a paper backing keeps it readable */
  .site-header.solid {
    background: rgb(239 237 231 / 0.92);
    box-shadow: 0 1px 0 rgb(22 21 15 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .site-header > * {
    pointer-events: auto;
  }
  .logo {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* On narrow screens Work, Photos and About show their icon only; the word stays for screen readers */
  @media (max-width: 600px) {
    .pill {
      padding-inline: 0.75rem;
    }
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const after = document.getElementById("statement");
  if (header && after) {
    let raf = 0;
    const check = () => {
      raf = 0;
      header.classList.toggle("solid", after.getBoundingClientRect().top <= header.offsetHeight);
    };
    addEventListener("scroll", () => (raf ||= requestAnimationFrame(check)), { passive: true });
    check();
  }
</script>
