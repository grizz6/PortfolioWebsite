---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { desk, watchFace, teaSteam, headlineWords } from "../data/desk";

// A pre-rendered cut-out (src/assets/desk/<key>.webp) wins; the drawing in desk-src is the fallback.
const cutouts = import.meta.glob<{ default: ImageMetadata }>("../assets/desk/*.{webp,png}", { eager: true });
const drawings = import.meta.glob<string>("../assets/desk-src/*.svg", { eager: true, query: "?url", import: "default" });
const drawingsRaw = import.meta.glob<string>("../assets/desk-src/*.svg", { eager: true, query: "?raw", import: "default" });

const find = <T,>(map: Record<string, T>, key: string) =>
  Object.entries(map).find(([p]) => p.split("/").pop()!.replace(/\.\w+$/, "") === key)?.[1];

const objects = desk.map((o) => {
  const cut: ImageMetadata | undefined = find(cutouts, o.key)?.default;
  const raw = find(drawingsRaw, o.key) ?? "";
  const [, , sw, sh] = (raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 100 100").split(/\s+/).map(Number);
  return { ...o, cut, svg: find(drawings, o.key), sw, sh };
});

const sizesFor = (o: (typeof desk)[number]) => `(max-width: 640px) ${o.wPhone}vw, ${o.w}vw`;
const widthsFor = (img: ImageMetadata) => [0.25, 0.5, 0.75, 1].map((k) => Math.round(img.width * k));
---

<section class="desk" id="top" aria-labelledby="hero-title" data-desk>
  <div class="stage" data-stage>
    <div class="objects" aria-hidden="true">
      {
        objects.map((o) => (
          <div
            class="obj"
            data-obj={o.key}
            data-label={o.label}
            data-scatter={o.scatter.join(",")}
            data-pile={o.pile.join(",")}
            data-phone-scatter={(o.phoneScatter ?? o.scatter).join(",")}
            data-phone-pile={(o.phonePile ?? o.pile).join(",")}
            data-phone-hide={o.hideOnPhone ? "" : undefined}
            style={`--w:${o.w};--wp:${o.wPhone};--x:${o.scatter[0]};--y:${o.scatter[1]};--r:${o.scatter[2]}deg`}
          >
            <div class="pop">
              <div class="lift">
                {o.cut ? (
                  <Image src={o.cut} alt="" widths={widthsFor(o.cut)} sizes={sizesFor(o)} loading="eager" draggable="false" />
                ) : (
                  <img src={o.svg} alt="" width={o.sw} height={o.sh} draggable="false" />
                )}
                {o.key === "watch" && (
                  <div
                    class="face"
                    style={`left:${watchFace.left}%;top:${watchFace.top}%;width:${watchFace.width}%;height:${watchFace.height}%`}
                  >
                    <span class="time" data-time>
                      9:41
                    </span>
                    <span class="tz" data-tz>
                      EST
                    </span>
                  </div>
                )}
                {o.key === "tea" && (
                  <svg class="steam" viewBox="0 0 60 80" style={`left:${teaSteam.left}%;top:${teaSteam.top}%`} fill="none">
                    <g filter="url(#wobble)" stroke="#16150F" stroke-width="3.4" stroke-linecap="round">
                      <path d="M14 74 C 4 60, 24 52, 14 38 S 20 16, 14 6" />
                      <path d="M30 70 C 20 56, 40 48, 30 32 S 36 12, 30 2" />
                      <path d="M46 74 C 36 60, 56 52, 46 38 S 52 18, 46 8" />
                    </g>
                  </svg>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="headline" data-headline>
      <h1 id="hero-title">
        <span class="sr-only">Hi, I'm Grishma, and I question data until it makes sense.</span>
        <span class="visual" aria-hidden="true">
          <span class="l">Hi, I'm Grishma,</span>{" "}
          <span class="l">
            and I{" "}
            <span class="slot" data-slot>
              {
                headlineWords.map((w, i) => (
                  <span class="word marker" data-word style={i ? "opacity:0" : undefined}>
                    {w}
                  </span>
                ))
              }
              <svg class="underline" viewBox="0 0 200 14" preserveAspectRatio="none">
                <path filter="url(#wobble)" d="M3 9 C 40 4, 90 12, 130 7 S 185 5, 197 8" />
              </svg>
            </span>{" "}
            data
          </span>{" "}
          <br class="br" />
          <span class="l">until it makes sense.</span>
        </span>
      </h1>
      <p class="sub">Data analyst. Ex-software engineer.</p>
    </div>

    <div class="hint hint-scroll" aria-hidden="true" data-hint>
      <svg viewBox="0 0 150 120" fill="none" stroke="#16150F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g filter="url(#wobble)">
          <!-- a hooded ninja doodle pointing you down the page -->
          <path d="M16 50 q0 -30 24 -30 q24 0 24 30 q-2 8 -8 10 h-32 q-6 -2 -8 -10 Z" />
          <path d="M22 38 h36 v9 h-36 Z" />
          <path d="M29 42 l6 2 M45 44 l6 -2" />
          <path d="M14 112 q0 -36 26 -48 q26 12 26 48" />
          <path d="M58 58 q12 6 24 -2 q-6 12 -20 12" />
          <path d="M30 80 l10 10 l10 -10" />
          <path d="M66 86 l16 -20 M78 62 l8 8" />
          <path d="M74 18 h62 q8 0 8 8 v26 q0 8 -8 8 h-44 l-14 12 l2 -12 h-6 q-8 0 -8 -8 v-26 q0 -8 8 -8 z" />
        </g>
        <text x="106" y="47" text-anchor="middle" fill="#16150F" stroke="none" font-family="Permanent Marker, cursive" font-size="20">scroll</text>
      </svg>
    </div>
    <p class="hint hint-throw marker" aria-hidden="true" data-hint>grab something. throw it.</p>

    <div class="tag marker" aria-hidden="true" data-tag></div>
  </div>
</section>

<style>
  .desk {
    position: relative;
  }
  .stage {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 30rem;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Objects. Without JavaScript they sit at their scattered spots; the script takes over positioning. */
  .obj {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1vw);
    transform: translate(-50%, -50%) rotate(var(--r));
    z-index: 1;
    container-type: inline-size;
  }
  :global(.js) .obj {
    left: 0;
    top: 0;
    transform: none;
    will-change: transform;
  }
  :global(.js) .pop {
    opacity: 0;
  }
  .lift {
    position: relative;
    filter: var(--shadow);
    transition:
      translate 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      scale 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      filter 0.25s;
  }
  .lift :global(img) {
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .obj:hover .lift,
  .obj.held .lift {
    translate: 0 -5px;
    scale: 1.035;
    filter: var(--shadow-up);
  }
  .obj.held .lift {
    scale: 1.07;
  }
  @media (hover: hover) and (pointer: fine) {
    .obj {
      cursor: grab;
    }
    .obj.held {
      cursor: grabbing;
    }
  }

  /* The watch shows the live time in New York */
  .face {
    position: absolute;
    display: grid;
    place-content: center;
    justify-items: center;
    color: #f4f3ef;
    font-family: var(--sans);
    line-height: 1;
  }
  .time {
    font-size: 19cqw;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .tz {
    margin-top: 0.35em;
    font-size: 8.5cqw;
    font-weight: 500;
    letter-spacing: 0.08em;
    opacity: 0.75;
  }

  .steam {
    position: absolute;
    width: 30%;
    translate: -50% -100%;
    overflow: visible;
  }

  /* Headline */
  .headline {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 5;
    width: min(92vw, 86rem);
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  /* the script takes over positioning; until then the headline paints where it starts */
  .headline.driven {
    top: 0;
    will-change: transform;
  }
  h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 4.6vw, 5.4rem) / 1.08 var(--serif);
    letter-spacing: -0.01em;
    text-shadow:
      0 0 0.3em var(--paper),
      0 0 0.6em var(--paper);
  }
  .l {
    white-space: nowrap;
  }
  .slot {
    position: relative;
    display: inline-block;
    height: 1.1em;
    vertical-align: -0.12em;
    margin-inline: 0.06em;
    text-align: left;
  }
  .word {
    position: absolute;
    left: 0;
    top: -0.06em;
    font-size: 0.86em;
    line-height: 1.3;
    white-space: nowrap;
  }
  .word:first-child {
    position: relative;
  }
  .underline {
    position: absolute;
    left: -2%;
    bottom: -0.2em;
    width: 104%;
    height: 0.24em;
    overflow: visible;
  }
  .underline path {
    fill: none;
    stroke: var(--underline);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .sub {
    margin: 1.1rem 0 0;
    color: var(--ink-2);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    text-shadow: 0 0 0.5em var(--paper);
  }

  /* Hints */
  .hint {
    position: absolute;
    bottom: clamp(1rem, 3vh, 2rem);
    z-index: 4;
    margin: 0;
    pointer-events: none;
  }
  .hint-scroll {
    left: var(--gutter);
    width: clamp(5.5rem, 8vw, 8rem);
  }
  .hint-throw {
    right: var(--gutter);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    transform: rotate(-3deg);
  }
  @media (hover: none), (pointer: coarse) {
    .hint-throw {
      display: none;
    }
  }

  /* Label tag that follows the hovered object */
  .tag {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    padding: 0.3rem 0.7rem 0.25rem;
    background: #fff;
    font-size: clamp(0.85rem, 1vw, 1rem);
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 2px 3px rgb(22 21 15 / 0.12), 0 8px 18px rgb(22 21 15 / 0.12);
    opacity: 0;
    transition: opacity 0.18s;
    pointer-events: none;
  }
  .tag.on {
    opacity: 1;
  }

  /* tablets: the same desk, objects a little larger */
  @media (min-width: 641px) and (max-width: 1024px) {
    .obj {
      width: calc(var(--w) * 1.35vw);
    }
  }
  @media (max-width: 640px) {
    .obj {
      width: calc(var(--wp) * 1vw);
    }
    .obj[data-phone-hide] {
      display: none;
    }
    .br {
      display: none;
    }
    .headline {
      width: calc(100vw - 2rem);
    }
  }
</style>

<script>
  import "../scripts/desk";
</script>
