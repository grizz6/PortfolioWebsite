---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { desk, watchFace, teaSteam, headlineWords } from "../data/desk";

// A pre-rendered cut-out (src/assets/desk/<key>.webp) wins; the drawing in desk-src is the fallback.
const cutouts = import.meta.glob<{ default: ImageMetadata }>("../assets/desk/*.{webp,png}", { eager: true });
const drawings = import.meta.glob<string>("../assets/desk-src/*.svg", { eager: true, query: "?url", import: "default" });
const drawingsRaw = import.meta.glob<string>("../assets/desk-src/*.svg", { eager: true, query: "?raw", import: "default" });

const find = <T,>(map: Record<string, T>, key: string) =>
  Object.entries(map).find(([p]) => p.split("/").pop()!.replace(/\.\w+$/, "") === key)?.[1];

const objects = desk.map((o) => {
  const cut: ImageMetadata | undefined = find(cutouts, o.key)?.default;
  const raw = find(drawingsRaw, o.key) ?? "";
  const [, , sw, sh] = (raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 100 100").split(/\s+/).map(Number);
  return { ...o, cut, svg: find(drawings, o.key), sw, sh };
});

// The phone's wallpaper: src/assets/desk/phone-screen.* sits on the phone's screen if it exists
const phoneScreen = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/desk/phone-screen.{png,jpg,jpeg,webp}", { eager: true }),
)[0]?.default;

// Your own laptop stickers: src/assets/desk/sticker-1.* and sticker-2.* sit in the two open spots on the lid
const stickers = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/desk/sticker-*.{png,jpg,jpeg,webp,svg}", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .slice(0, 2)
  .map(([, m]) => m.default);
const stickerSpots = [
  { left: 83.5, top: 47, rot: 8 },
  { left: 75, top: 73, rot: -6 },
];

// Your own scroll-hint character wins: src/assets/doodles/scroll.png / .webp / .svg
const ownHint = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/doodles/scroll.{png,webp,svg}", { eager: true }),
)[0]?.default;

const sizesFor = (o: (typeof desk)[number]) => `(max-width: 640px) ${o.wPhone}vw, ${o.w}vw`;
const widthsFor = (img: ImageMetadata) => [0.25, 0.5, 0.75, 1].map((k) => Math.round(img.width * k));
---

<section class="desk" id="top" aria-labelledby="hero-title" data-desk>
  <div class="stage" data-stage>
    <div class="objects" aria-hidden="true">
      {
        objects.map((o) => (
          <div
            class="obj"
            data-obj={o.key}
            data-label={o.label}
            data-scatter={o.scatter.join(",")}
            data-pile={o.pile.join(",")}
            data-phone-scatter={(o.phoneScatter ?? o.scatter).join(",")}
            data-phone-pile={(o.phonePile ?? o.pile).join(",")}
            data-phone-hide={o.hideOnPhone ? "" : undefined}
            style={`--w:${o.w};--wp:${o.wPhone};--x:${o.scatter[0]};--y:${o.scatter[1]};--r:${o.scatter[2]}deg`}
          >
            <div class="pop">
              <div class="lift">
                {o.cut ? (
                  <Image src={o.cut} alt="" widths={widthsFor(o.cut)} sizes={sizesFor(o)} loading="eager" draggable="false" />
                ) : (
                  <img src={o.svg} alt="" width={o.sw} height={o.sh} draggable="false" />
                )}
                {o.key === "laptop" &&
                  stickers.map((img, k) => (
                    <div class="sticker" style={`left:${stickerSpots[k].left}%;top:${stickerSpots[k].top}%;--rot:${stickerSpots[k].rot}deg`}>
                      <Image src={img} alt="" width={200} loading="eager" />
                    </div>
                  ))}
                {o.key === "phone" && phoneScreen && (
                  <div class="screen">
                    <Image src={phoneScreen} alt="" width={320} loading="eager" />
                  </div>
                )}
                {o.key === "watch" && (
                  <div
                    class="face"
                    style={`left:${watchFace.left}%;top:${watchFace.top}%;width:${watchFace.width}%;height:${watchFace.height}%`}
                  >
                    <span class="time" data-time>
                      9:41
                    </span>
                    <span class="tz" data-tz>
                      EST
                    </span>
                  </div>
                )}
                {o.key === "tea" && (
                  <svg class="steam" viewBox="0 0 60 80" style={`left:${teaSteam.left}%;top:${teaSteam.top}%`} fill="none">
                    <g filter="url(#wobble)" stroke="#16150F" stroke-width="3.4" stroke-linecap="round">
                      <path d="M14 74 C 4 60, 24 52, 14 38 S 20 16, 14 6" />
                      <path d="M30 70 C 20 56, 40 48, 30 32 S 36 12, 30 2" />
                      <path d="M46 74 C 36 60, 56 52, 46 38 S 52 18, 46 8" />
                    </g>
                  </svg>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="headline" data-headline>
      <h1 id="hero-title">
        <span class="sr-only">Hi, I'm Grishma, and I question data until it makes sense.</span>
        <span class="visual" aria-hidden="true">
          <span class="l">Hi, I'm Grishma,</span>{" "}
          <span class="l">
            and I{" "}
            <span class="slot" data-slot>
              {
                headlineWords.map((w, i) => (
                  <span class="word marker" data-word style={i ? "opacity:0" : undefined}>
                    {w}
                  </span>
                ))
              }
              <svg class="highlight" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2 10 C 40 4, 120 6, 197 8 L 199 32 C 140 36, 60 34, 4 35 Z" />
              </svg>
            </span>{" "}
            data
          </span>{" "}
          <br class="br" />
          <span class="l">until it makes sense.</span>
        </span>
      </h1>
      <p class="sub">Data analyst. Ex-software engineer.</p>
    </div>

    <div class="hint hint-scroll" aria-hidden="true" data-hint>
      {ownHint && <span class="own-hint" data-own-hint={ownHint.src} data-w={ownHint.width} data-h={ownHint.height} />}
      {
        ownHint && (
          <span class="say marker">
            <svg viewBox="0 0 130 110" fill="none">
              <!-- "scroll" written along a curve, then an arrow that draws itself down toward the page -->
              <path id="say-curve" d="M4 46 Q 52 6 104 30" />
              <text font-size="21" fill="#16150F"><textPath href="#say-curve" startOffset="2">scroll</textPath></text>
              <path class="say-arrow" pathLength="1" filter="url(#wobble)" d="M110 36 Q 124 62 104 96" />
              <path class="say-head" pathLength="1" filter="url(#wobble)" d="M94 84 L104 97 L116 88" />
            </svg>
          </span>
        )
      }
      <svg class={ownHint ? "has-own" : undefined} viewBox="0 0 150 120" fill="none" stroke="#16150F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g filter="url(#wobble)">
          <!-- an original chibi ninja, sketched: hood up, mask on, bun peeking out, scroll in hand -->
          <g transform="translate(-2 10) scale(0.82)" class="ninja">
            <path d="M24 74 L18 108 H62 L56 74 Z" fill="#E2DDD1" />
            <path d="M40 74 V108 M22 92 l-8 8 M58 84 l14 -8" />
            <path d="M68 70 h14 a3 6 0 0 1 0 12 h-14 a3 6 0 0 1 0 -12 Z" fill="#FBFAF7" />
            <path d="M40 2 a8 7 0 1 0 0.1 0" fill="#3B3A33" />
            <path d="M8 50 C6 20 24 6 40 6 C58 6 76 20 74 50 C72 62 58 74 40 74 C22 74 10 62 8 50 Z" fill="#3B3A33" />
            <path d="M16 48 C14 30 26 20 40 20 C54 20 66 30 64 48 C64 60 54 68 40 68 C26 68 16 60 16 48 Z" fill="#FBFAF7" />
            <path d="M16 52 Q40 46 64 52 L62 62 Q40 72 18 62 Z" fill="#3B3A33" />
            <path d="M24 36 L35 40 M56 36 L45 40" stroke-width="3.4" />
            <ellipse cx="31" cy="45" rx="2.8" ry="3.4" fill="#16150F" stroke="none" />
            <ellipse cx="49" cy="45" rx="2.8" ry="3.4" fill="#16150F" stroke="none" />
          </g>
          <path d="M74 18 h62 q8 0 8 8 v26 q0 8 -8 8 h-44 l-14 12 l2 -12 h-6 q-8 0 -8 -8 v-26 q0 -8 8 -8 z" />
        </g>
        <text x="106" y="47" text-anchor="middle" fill="#16150F" stroke="none" font-family="Permanent Marker, cursive" font-size="20">scroll</text>
      </svg>
    </div>
    <p class="hint hint-throw marker" aria-hidden="true" data-hint>grab something. throw it.</p>

    <div class="tag marker" aria-hidden="true" data-tag></div>
    <div class="cursor" aria-hidden="true" data-cursor><span class="marker" data-cursor-word>grab</span></div>
  </div>
</section>

<style>
  .desk {
    position: relative;
  }
  .stage {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 30rem;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Objects. Without JavaScript they sit at their scattered spots; the script takes over positioning. */
  .obj {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1vw);
    transform: translate(-50%, -50%) rotate(var(--r));
    z-index: 1;
    container-type: inline-size;
  }
  :global(.js) .obj {
    left: 0;
    top: 0;
    transform: none;
    will-change: transform;
  }
  :global(.js) .pop {
    opacity: 0;
  }
  .lift {
    position: relative;
    filter: var(--shadow);
    transition:
      translate 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      scale 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      filter 0.25s;
  }
  .lift :global(img) {
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  /* at rest, each object sways a hair, each on its own timing, so the desk never looks frozen */
  @media (prefers-reduced-motion: no-preference) {
    .lift {
      animation: sway 6s ease-in-out infinite;
      animation-delay: calc(var(--w) * -0.45s);
    }
    .obj:nth-child(even) .lift {
      animation-duration: 7.5s;
      animation-direction: reverse;
    }
    .obj.held .lift {
      animation-play-state: paused;
    }
    .hint-scroll svg {
      animation: nudge 2.6s ease-in-out infinite;
    }
  }
  @keyframes sway {
    0%, 100% { rotate: -0.7deg; }
    50% { rotate: 0.7deg; }
  }
  @keyframes nudge {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -4px; }
  }
  .obj:hover .lift,
  .obj.held .lift {
    translate: 0 -5px;
    scale: 1.035;
    filter: var(--shadow-up);
  }
  .obj.held .lift {
    scale: 1.07;
  }
  @media (hover: hover) and (pointer: fine) {
    .obj {
      cursor: grab;
    }
    .obj.held {
      cursor: grabbing;
    }
  }

  /* On the desk, a mouse gets a marker dot for a cursor that swells into "grab" over objects.
     The script only turns it on for a mouse, and never with reduced motion. */
  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    pointer-events: none;
    opacity: 0;
    transition:
      width 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      height 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      margin 0.25s cubic-bezier(0.3, 0.7, 0.4, 1),
      opacity 0.2s;
  }
  .cursor span {
    font-size: 0.8rem;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .stage.custom-cursor,
  .stage.custom-cursor .obj {
    cursor: none;
  }
  .stage.custom-cursor .cursor.on {
    opacity: 1;
  }
  .cursor.big {
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
  }
  .cursor.big span {
    opacity: 1;
  }

  /* Your own stickers on the laptop lid, with a white die-cut edge */
  .sticker {
    position: absolute;
    width: 17%;
    translate: -50% -50%;
    rotate: var(--rot);
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff) drop-shadow(0 0 1.5px #fff) drop-shadow(0 1px 1px rgb(22 21 15 / 0.25));
  }
  .sticker :global(img) {
    width: 100%;
    height: auto;
  }

  /* The phone's wallpaper, laid over the drawn screen, with the camera pill on top */
  .screen {
    position: absolute;
    left: 13.8%;
    top: 7.6%;
    width: 72.4%;
    height: 84.8%;
    overflow: hidden;
    border-radius: 15% / 7%;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .screen::after {
    content: "";
    position: absolute;
    top: 2.6%;
    left: 50%;
    width: 30%;
    height: 4.2%;
    border-radius: 999px;
    background: #0b0b0c;
    translate: -50% 0;
  }

  /* The watch shows the live time in New York */
  .face {
    position: absolute;
    display: grid;
    place-content: center;
    justify-items: center;
    color: #f4f3ef;
    font-family: var(--sans);
    line-height: 1;
  }
  .time {
    font-size: 19cqw;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .tz {
    margin-top: 0.35em;
    font-size: 8.5cqw;
    font-weight: 500;
    letter-spacing: 0.08em;
    opacity: 0.75;
  }

  .steam {
    position: absolute;
    width: 30%;
    translate: -50% -100%;
    overflow: visible;
  }

  /* Headline */
  .headline {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 5;
    width: min(92vw, 86rem);
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  /* the script takes over positioning; until then the headline paints where it starts */
  .headline.driven {
    top: 0;
    will-change: transform;
  }
  h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 4.6vw, 5.4rem) / 1.08 var(--serif);
    letter-spacing: -0.01em;
    text-shadow:
      0 0 0.3em var(--paper),
      0 0 0.6em var(--paper);
  }
  .l {
    white-space: nowrap;
  }
  .slot {
    position: relative;
    display: inline-block;
    height: 1.1em;
    vertical-align: -0.12em;
    margin-inline: 0.06em;
    text-align: left;
  }
  .word {
    position: absolute;
    left: 0;
    top: -0.06em;
    font-size: 0.86em;
    line-height: 1.3;
    white-space: nowrap;
  }
  .word:first-child {
    position: relative;
  }
  /* a yellow highlighter swipe behind the changing word, so it reads clearly over the desk */
  .highlight {
    position: absolute;
    left: -5%;
    top: 4%;
    z-index: -1;
    width: 110%;
    height: 96%;
    overflow: visible;
  }
  .highlight path {
    fill: var(--note);
    opacity: 0.95;
  }
  .slot {
    isolation: isolate;
  }
  .sub {
    margin: 1.1rem 0 0;
    color: var(--ink-2);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    text-shadow: 0 0 0.5em var(--paper);
  }

  /* Hints */
  .hint {
    position: absolute;
    bottom: clamp(1rem, 3vh, 2rem);
    z-index: 4;
    margin: 0;
    pointer-events: none;
  }
  .hint-scroll {
    left: var(--gutter);
    width: clamp(5.5rem, 8vw, 8rem);
  }
  .own-hint {
    width: 100%;
    height: auto;
  }
  /* your own character sits on the bottom edge of the desk with a speech bubble above its head.
     It scales with the screen, and a soft shadow underneath grounds it. */
  .hint-scroll:has(.own-hint) {
    bottom: 0;
    width: clamp(6.5rem, 10vw, 9.5rem);
    aspect-ratio: 344 / 337;
  }
  .hint-scroll:has(.own-hint) > svg {
    display: none;
  }
  .own-hint {
    display: block;
    position: absolute;
    inset: 0;
    width: 100% !important;
  }
  .own-hint::after {
    content: "";
    position: absolute;
    left: 14%;
    right: 10%;
    bottom: -3%;
    height: 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(22 21 15 / 0.22), transparent);
    z-index: -1;
  }
  /* "scroll" written along a curve beside the character, with an arrow that keeps drawing itself downward */
  .say {
    position: absolute;
    left: 42%;
    bottom: 60%;
    width: clamp(5.5rem, 7vw, 7rem);
    font-size: 1rem;
    line-height: 1;
  }
  .say svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .say text {
    font-family: var(--marker);
    letter-spacing: 0.04em;
  }
  .say path:not([id]) {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #say-curve {
    stroke: none;
  }
  @media (min-width: 641px) and (max-width: 1024px) {
    .say {
      left: 0;
      bottom: 92%;
    }
  }
  @media (max-width: 380px) {
    .say {
      left: 30%;
      bottom: 74%;
      width: 5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .say-arrow,
    .say-head {
      stroke-dasharray: 1;
      animation: say-draw 2.8s ease-in-out infinite;
    }
    .say-head {
      animation-name: say-head;
    }
  }
  @keyframes say-draw {
    0% { stroke-dashoffset: 1; }
    40%, 80% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes say-head {
    0%, 35% { stroke-dashoffset: 1; }
    50%, 80% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @media (max-width: 640px) {
    .hint-scroll:has(.own-hint) {
      width: 26vw;
    }
  }
  .has-own .ninja {
    display: none;
  }
  .hint-throw {
    right: var(--gutter);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    transform: rotate(-3deg);
  }
  @media (hover: none), (pointer: coarse) {
    .hint-throw {
      display: none;
    }
  }

  /* Label tag that follows the hovered object */
  .tag {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 30;
    padding: 0.3rem 0.7rem 0.25rem;
    background: #fff;
    font-size: clamp(0.85rem, 1vw, 1rem);
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 2px 3px rgb(22 21 15 / 0.12), 0 8px 18px rgb(22 21 15 / 0.12);
    opacity: 0;
    transition: opacity 0.18s;
    pointer-events: none;
  }
  .tag.on {
    opacity: 1;
  }

  /* tablets: the same desk, objects a little larger */
  @media (min-width: 641px) and (max-width: 1024px) {
    .obj {
      width: calc(var(--w) * 1.35vw);
    }
  }
  @media (max-width: 640px) {
    .obj {
      width: calc(var(--wp) * 1vw);
    }
    .obj[data-phone-hide] {
      display: none;
    }
    .br {
      display: none;
    }
    .headline {
      width: calc(100vw - 2rem);
    }
  }
</style>

<script>
  import "../scripts/desk";

  // your scroll-hint character arrives just after the page has loaded, so it never slows the first paint
  const slot = document.querySelector<HTMLElement>("[data-own-hint]");
  if (slot) {
    const place = () => {
      const img = new Image(Number(slot.dataset.w), Number(slot.dataset.h));
      img.alt = "";
      img.decoding = "async";
      img.src = slot.dataset.ownHint!;
      img.style.width = "100%";
      img.style.height = "auto";
      slot.appendChild(img);
    };
    if (document.readyState === "complete") place();
    else addEventListener("load", () => setTimeout(place, 150), { once: true });
  }
</script>
