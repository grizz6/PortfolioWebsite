---
import type { ImageMetadata } from "astro";
const year = new Date().getFullYear();

// Your own drawing wins: put crew.png / crew.webp / crew.svg in src/assets/doodles and it walks across instead.
const own = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/doodles/crew.{png,webp,svg}", { eager: true }),
)[0]?.default;

// A doodled ship sailing across, flying a classic skull and crossbones.
// Every stroke is drawn twice, the second a hair off the first, like quick pencil work.
const ship = [
  { d: "M20 120 H236 Q226 148 196 152 H64 Q34 148 20 120 Z", fill: "#E2DDD1" },
  { d: "M28 132 H228 M60 141 h16 M96 141 h16 M132 141 h16 M168 141 h16" },
  { d: "M236 120 L262 104 M244 115 L262 104" },
  { d: "M128 120 V18" },
  { d: "M86 30 Q128 22 170 30 Q182 54 170 78 Q128 70 86 78 Q74 54 86 30 Z", fill: "#FBFAF7" },
  { d: "M90 86 Q128 80 166 86 Q174 100 166 114 Q128 108 90 114 Q82 100 90 86 Z", fill: "#FBFAF7" },
  { d: "M80 28 H176 M84 84 H172" },
  { d: "M128 18 H160 V40 H128", fill: "#3B3A33" },
];
// the flag's skull and crossbones, in paper on the dark flag
const flag = "M139 30 L149 36 M149 30 L139 36 M144 23 a5 5 0 1 0 0.1 0 M141 27.5 h1 M146 27.5 h1";
const waves = "M0 156 q16 -8 32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t24 0";
---

<footer class="site-footer">
  <div class="sky" aria-hidden="true">
    {own ? <img class="crew" src={own.src} width={own.width} height={own.height} alt="" /> : <svg class="crew" viewBox="0 0 280 164" fill="none">
      <g filter="url(#wobble)" stroke="#16150F" stroke-linecap="round" stroke-linejoin="round">
        <path d={waves} stroke-width="1.8" stroke-dasharray="1 7" />
        <g class="bob">
          {[0, 1].map((n) => (
            <g stroke-width={n ? 1 : 2} opacity={n ? 0.45 : 1} transform={n ? "translate(0.9 0.6)" : undefined}>
              {ship.map((part) => (
                <path d={part.d} fill={!n && part.fill ? part.fill : "none"} />
              ))}
            </g>
          ))}
          <path d={flag} stroke="#FBFAF7" stroke-width="1.6" />
        </g>
      </g>
    </svg>}
  </div>
  <div class="row">
    <p>Grishma Gajurel, {year}</p>
    <a href="#top">Back to the desk</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 2rem;
    overflow: clip;
  }
  .sky {
    height: clamp(7rem, 11vw, 10rem);
    position: relative;
  }
  .crew {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: clamp(10rem, 16vw, 14rem);
    animation: drift 30s linear infinite;
  }
  /* the ship rocks gently on the waves */
  .bob {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(2deg) translateY(-2px); }
  }
  @keyframes drift {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(calc(100vw + 10%));
    }
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    max-width: 82rem;
    margin: 0 auto;
    padding-top: 1.2rem;
    border-top: 1px solid #d3cec2;
    font-size: 0.95rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  a {
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .bob {
      animation: none;
    }
    .crew {
      animation: none;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
