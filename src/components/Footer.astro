---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sky" aria-hidden="true">
    <svg class="crew" viewBox="0 0 200 84" fill="none">
      <!-- an original doodled crew, walking across: a captain in a straw hat leads -->
      <g filter="url(#wobble)" stroke="#16150F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <g class="walker" transform="translate(160 0)">
          <circle cx="20" cy="22" r="7" />
          <path d="M20 29 V54" />
          <g class="pose-a"><path d="M20 34 l-9 12 M20 34 l9 10 M20 54 l-8 22 M20 54 l9 21" /></g>
          <g class="pose-b"><path d="M20 34 l-4 14 M20 34 l5 14 M20 54 l-2 22 M20 54 l3 22" /></g>
          <path d="M9 17 q11 -5 22 0 M13 16 q1 -9 7 -9 t7 9" />
        </g>
        <g class="walker" transform="translate(40 0)">
          <circle cx="20" cy="22" r="7" />
          <path d="M20 29 V54" />
          <g class="pose-a"><path d="M20 34 l-9 12 M20 34 l9 10 M20 54 l-8 22 M20 54 l9 21" /></g>
          <g class="pose-b"><path d="M20 34 l-4 14 M20 34 l5 14 M20 54 l-2 22 M20 54 l3 22" /></g>
          <path d="M14 18 q6 -4 12 0 M26 18 l6 -3 M8 46 L30 30" />
        </g>
        <g class="walker" transform="translate(80 0)">
          <circle cx="20" cy="22" r="7" />
          <path d="M20 29 V54" />
          <g class="pose-a"><path d="M20 34 l-9 12 M20 34 l9 10 M20 54 l-8 22 M20 54 l9 21" /></g>
          <g class="pose-b"><path d="M20 34 l-4 14 M20 34 l5 14 M20 54 l-2 22 M20 54 l3 22" /></g>
          <path d="M14 18 q-4 10 -2 18 M26 18 q4 10 2 18 M32 30 v34" />
        </g>
        <g class="walker" transform="translate(120 0)">
          <circle cx="20" cy="22" r="7" />
          <path d="M20 29 V54" />
          <g class="pose-a"><path d="M20 34 l-9 12 M20 34 l9 10 M20 54 l-8 22 M20 54 l9 21" /></g>
          <g class="pose-b"><path d="M20 34 l-4 14 M20 34 l5 14 M20 54 l-2 22 M20 54 l3 22" /></g>
          <path d="M13 28 q7 5 14 0 M27 28 l6 6" />
        </g>
        <g class="walker" transform="translate(0 0)">
          <circle cx="20" cy="22" r="7" />
          <path d="M20 29 V54" />
          <g class="pose-a"><path d="M20 34 l-9 12 M20 34 l9 10 M20 54 l-8 22 M20 54 l9 21" /></g>
          <g class="pose-b"><path d="M20 34 l-4 14 M20 34 l5 14 M20 54 l-2 22 M20 54 l3 22" /></g>
          <path d="M24 32 h10 v18 h-10" />
        </g>
      </g>
    </svg>
  </div>
  <div class="row">
    <p>Grishma Gajurel, {year}</p>
    <a href="#top">Back to the desk</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 2rem;
    overflow: clip;
  }
  .sky {
    height: clamp(5rem, 8vw, 7rem);
    position: relative;
  }
  .crew {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: clamp(12rem, 20vw, 16rem);
    animation: drift 30s linear infinite;
  }
  /* legs and arms swap between two poses, like a flip book */
  .pose-b {
    opacity: 0;
  }
  .crew .pose-a {
    animation: step 0.5s steps(1) infinite;
  }
  .crew .pose-b {
    animation: step 0.5s steps(1) infinite reverse;
  }
  .walker:nth-child(even) .pose-a,
  .walker:nth-child(even) .pose-b {
    animation-delay: -0.25s;
  }
  @keyframes step {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes drift {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(calc(100vw + 10%));
    }
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    max-width: 82rem;
    margin: 0 auto;
    padding-top: 1.2rem;
    border-top: 1px solid #d3cec2;
    font-size: 0.95rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  a {
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .crew .pose-a,
    .crew .pose-b {
      animation: none;
    }
    .crew {
      animation: none;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
