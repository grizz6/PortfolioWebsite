---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sky" aria-hidden="true">
    <svg class="plane" viewBox="0 0 260 60" fill="none">
      <g filter="url(#wobble)" stroke="#16150F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 44 C 50 52, 90 20, 140 34 S 190 40, 206 30" stroke-dasharray="2 9" />
        <path d="M212 28 L256 8 L234 50 L224 36 Z M224 36 L256 8 M224 36 L222 48 L232 42" />
      </g>
    </svg>
  </div>
  <div class="row">
    <p>Grishma Gajurel, {year}</p>
    <a href="#top">Back to the desk</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 2rem;
    overflow: clip;
  }
  .sky {
    height: 5.5rem;
    position: relative;
  }
  .plane {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: clamp(10rem, 22vw, 16rem);
    animation: drift 18s linear infinite;
  }
  @keyframes drift {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(calc(100vw + 10%));
    }
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    max-width: 82rem;
    margin: 0 auto;
    padding-top: 1.2rem;
    border-top: 1px solid #d3cec2;
    font-size: 0.95rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  a {
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .plane {
      animation: none;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
