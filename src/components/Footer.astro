---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sky" aria-hidden="true">
    <svg class="ship" viewBox="0 0 220 120" fill="none">
      <g filter="url(#wobble)" stroke="#16150F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <!-- a little doodled ship with a straw hat on the mast, sailing across -->
        <path d="M2 108 q14 -8 28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t22 0" stroke-dasharray="1 7" />
        <path d="M26 78 H194 Q184 102 158 102 H64 Q38 102 26 78 Z" />
        <circle cx="72" cy="89" r="3" /><circle cx="98" cy="89" r="3" /><circle cx="124" cy="89" r="3" /><circle cx="150" cy="89" r="3" />
        <path d="M194 78 l20 -12" />
        <path d="M110 78 V16" />
        <path d="M76 26 Q110 20 144 26 Q153 46 144 66 Q110 60 76 66 Q67 46 76 26 Z" />
        <path d="M70 24 H150" />
        <path d="M110 20 l22 5 l-22 5" />
        <path d="M94 15 q16 -6 32 0 q-16 5 -32 0 Z" />
        <path d="M101 13 q1 -10 9 -10 t9 10" />
        <path d="M101.5 10 h17" />
      </g>
    </svg>
  </div>
  <div class="row">
    <p>Grishma Gajurel, {year}</p>
    <a href="#top">Back to the desk</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 2rem;
    overflow: clip;
  }
  .sky {
    height: clamp(5rem, 8vw, 7rem);
    position: relative;
  }
  .ship {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: clamp(7rem, 12vw, 10rem);
    animation: drift 26s linear infinite;
  }
  @keyframes drift {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(calc(100vw + 10%));
    }
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    max-width: 82rem;
    margin: 0 auto;
    padding-top: 1.2rem;
    border-top: 1px solid #d3cec2;
    font-size: 0.95rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  a {
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .ship {
      animation: none;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
