---
import type { ImageMetadata } from "astro";
const year = new Date().getFullYear();


// Your own drawings win. Every image in src/assets/doodles other than scroll.* walks across the footer,
// in file-name order. Files are used exactly as uploaded, so an animated WebP or GIF keeps moving.
const crewFiles = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/doodles/*.{png,webp,gif,svg}", { eager: true }),
)
  .filter(([path]) => !/\/scroll\.[a-z]+$/.test(path))
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, m]) => m.default);

// A chubby little sailboat bobbing across, with a gull riding on the mast.
// Every stroke is drawn twice, the second a hair off the first, like quick pencil work.
const ship = [
  { d: "M36 112 H204 Q206 150 170 152 H70 Q34 150 36 112 Z", fill: "#E2DDD1" },
  { d: "M40 124 Q120 130 200 124" },
  { d: "M80 136 a6 6 0 1 0 0.1 0 M120 137 a6 6 0 1 0 0.1 0 M160 136 a6 6 0 1 0 0.1 0", fill: "#FBFAF7" },
  { d: "M118 112 V30" },
  { d: "M122 34 Q178 52 178 104 H122 Z", fill: "#FBFAF7" },
  { d: "M114 46 Q76 70 78 104 H114 Z", fill: "#FFE36E" },
  { d: "M118 30 L140 22 L118 16 Z", fill: "#3B3A33" },
  { d: "M108 16 q5 -6 10 0 q5 -6 10 0" },
];
const waves = "M0 156 q16 -8 32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t32 0 t24 0";
const puffs = "M20 100 a4 4 0 1 0 0.1 0 M10 88 a3 3 0 1 0 0.1 0 M214 96 a3 3 0 1 0 0.1 0";
---

<footer class="site-footer">
  <div class="sky" aria-hidden="true">
    {crewFiles.length ? (
      <div class="crew crew-own">
        {crewFiles.map((img, i) => (
          <img src={img.src} width={img.width} height={img.height} alt="" style={`--i:${i}`} loading="lazy" decoding="async" />
        ))}
      </div>
    ) : <svg class="crew" viewBox="0 0 280 164" fill="none">
      <g filter="url(#wobble)" stroke="#16150F" stroke-linecap="round" stroke-linejoin="round">
        <path d={waves} stroke-width="1.8" stroke-dasharray="1 7" />
        <g class="bob">
          {[0, 1].map((n) => (
            <g stroke-width={n ? 1 : 2} opacity={n ? 0.45 : 1} transform={n ? "translate(0.9 0.6)" : undefined}>
              {ship.map((part) => (
                <path d={part.d} fill={!n && part.fill ? part.fill : "none"} />
              ))}
            </g>
          ))}
          <path d={puffs} stroke-width="1.4" />
        </g>
      </g>
    </svg>}
  </div>
  <div class="row">
    <p>Grishma Gajurel, {year}</p>
    <a href="#top">Back to the desk</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--gutter) 2rem;
    overflow: clip;
  }
  .sky {
    height: clamp(7rem, 11vw, 10rem);
    position: relative;
  }
  .crew {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: clamp(10rem, 16vw, 14rem);
    animation: drift 30s linear infinite;
  }
  /* the ship rocks gently on the waves */
  .bob {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(2deg) translateY(-2px); }
  }
  @keyframes drift {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(calc(100vw + 10%));
    }
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    max-width: 82rem;
    margin: 0 auto;
    padding-top: 1.2rem;
    border-top: 1px solid #d3cec2;
    font-size: 0.95rem;
  }
  p {
    margin: 0;
    color: var(--ink-2);
  }
  a {
    text-underline-offset: 0.2em;
  }
  /* your own crew: one line of characters, each taking little steps out of time with the next */
  .crew-own {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.4rem, 1vw, 0.9rem);
    width: max-content;
  }
  .crew-own img {
    height: clamp(5rem, 8vw, 7.5rem);
    width: auto;
  }
  /* separate still drawings take little steps; an animated strip already walks on its own */
  .crew-own img:not([src*=".webp"]):not([src*=".gif"]) {
    animation: hop 0.6s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.3s);
  }
  @keyframes hop {
    from { translate: 0 0; rotate: -2deg; }
    to { translate: 0 -4px; rotate: 2deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crew-own img {
      animation: none;
    }
    .bob {
      animation: none;
    }
    .crew {
      animation: none;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
