---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import note from "../assets/desk/note.webp";
---

<Base title="Off the desk | Grishma Gajurel" noindex>
  <main id="main" class="lost">
    <Image src={note} alt="" width={180} class="note" loading="eager" />
    <h1 class="marker">off the desk.</h1>
    <p>That page isn't here. It may have moved when I rebuilt the site.</p>
    <a class="pill pill--dark" href="/">Back to the desk</a>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1.2rem;
    min-height: 100svh;
    padding: 2rem var(--gutter);
    text-align: center;
  }
  .note {
    width: 9rem;
    height: auto;
    transform: rotate(-6deg);
    filter: var(--shadow);
  }
  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 400;
    line-height: 1;
  }
  p {
    max-width: 26rem;
    margin: 0;
    color: var(--ink-2);
    font: italic 400 1.4rem/1.3 var(--serif);
  }
</style>
